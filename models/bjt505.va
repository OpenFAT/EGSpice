`MPRco( nfibrel        ,2.0            ,""            ,0.1         ,inf         ,"Non-ideality factor of base current for reliability simulation" )

`MPRcc( vexlim         ,400.0          ,""            ,40.0        ,400.0       ,"Upper limit of exp() function argument for convergence" )
`MPRcc( vexlimr        ,400.0          ,""            ,40.0        ,400.0       ,"Lower limit of exp() function argument for convergence" )

`MPRcc( p0starlim      ,1.0e-40        ,""            ,0.0         ,1.0e-20     ,"Lower limit for p0star clipping" )
`MPRcc( pwlim          ,1.0e-40        ,""            ,0.0         ,1.0e-20     ,"Lower limit for pW clipping" )
`MPRcc( iclimvbcstar   ,1.0e-15        ,""            ,0.0         ,1.0         ,"Ic1c2 threshold for using Vb2c2star = Vt*ln(eVb2c2star) branch" )

`MPRcz( minr           ,$simparam("minr", 1.0e-3)         ,"Ohm"                ,"Minimum resistance" )

//trap-assisted tunneling
`MPRcz( istat            ,0.0          ,"A"                                      ,"Saturation current of TAT current" )
`MPRoz( vtat             ,1.0          ,"A"                                      ,"Coefficient of TAT current" )
`MPRnb( ktat             ,0.0          ,""                                       ,"Temperature coefficient of TAT current" )
//tunneling current
`MPRcz( vbtbt             ,0.16         ,"V"                                     ,"Coefficient of base tunneling current" )
`MPRnb( kbtbt             ,0.0          ,""                                      ,"Coefficient of base tunneling current" )

// exmod = 4: quasi-static transit time for the XQex formula at B-C3
`MPRcz( tauxqex        ,10.0p        ,"s"                                      ,"Quasi-static transit time of reverse extrinsic stored epilayer charge of B-C3 nodes; used when exmod = 4 (independent of swqex)" )

// exmod = 4: NQS first-order lag dynamics for Qex and XQex
`MPRnb( aqexnqs        ,2.5          ,""                                       ,"Temperature coefficient of NQS transit times for Qex and XQex" )
`MPRco( taunqsqex      ,0.0          ,"s"           ,0.0         ,inf          ,"NQS characteristic time for Qex" )
`MPRco( taunqsxqex     ,0.0          ,"s"           ,0.0         ,inf          ,"NQS characteristic time for XQex" )
