real      fs01_dPs0, fs02, fs02_dPs0, Fs0, Fs0_dPs0, dPs0, dPsl, dPlim ;
real      fsl1, fsl1_dPsl, fsl2, fsl2_dPsl, Rho, exp_Rho, Fsl, Fsl_dPsl ;
real      Eta, Eta1, Eta1p12, Zeta12, F00 ;
real      F10, Fdd, DtPds ;
