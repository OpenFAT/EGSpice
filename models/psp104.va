`MPRnb(POPSCEEDGE     ,0.0        ,""                                   ,"Binning parameter of the geometry independent part of PSCEEDGE")
`MPRnb(PLPSCEEDGE     ,0.0        ,""                                   ,"Binning parameter of the length dependence of PSCEEDGE")
`MPRnb(PWPSCEEDGE     ,0.0        ,""                                   ,"Binning parameter of the width dependence of PSCEEDGE")
`MPRnb(PLWPSCEEDGE    ,0.0        ,""                                   ,"Binning parameter of the area dependence of PSCEEDGE")
`MPRnb(POPSCEBEDGE    ,0.0        ,"V^-1"                               ,"Binning parameter of the geometry independent part of PSCEBEDGE")
`MPRnb(PLPSCEBEDGE    ,0.0        ,"V^-1"                               ,"Binning parameter of the length dependence of PSCEBEDGE")
