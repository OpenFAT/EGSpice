    `MPRco(FVBIRGAT2D     ,1.0        ,""         ,`F2_cliplow       ,inf              ,"Built-in voltage at the reference temperature of gate-edge component factor, drain-bulk 2nd junction")
    `MPRco(FPGAT2D        ,1.0        ,""         ,`F2_cliplow       ,inf              ,"Grading coefficient of gate-edge component factor, drain-bulk 2nd junction")
    `MPRco(FPHIGGAT2D     ,1.0        ,""         ,`F2_cliplow       ,inf              ,"Zero-temperature bandgap voltage of gate-edge component factor, drain-bulk 2nd junction")
    `MPRcc(VTRGATD        ,-1.0       ,"V"        ,`VTRGAT_cliplow   ,`VTRGAT_cliphigh ,"Transition voltage of 2nd region gate-edge component, drain-bulk junction")
    `MPRcc(ANUGATD        ,0.1        ,"V"        ,`ANUGAT_cliplow   ,`ANUGAT_cliphigh ,"Transition width coefficient of 2nd region gate-edge component, drain-bulk 2nd junction")
