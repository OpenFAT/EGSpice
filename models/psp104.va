    `MPRco(ADBBTGATD      ,0.0        ,""         ,`ADBBT_cliplow    ,inf              ,"Gate dependent band-to-band tunneling shift prefactor of gate-edge component for drain-bulk junction")
    `MPRco(BDBBTGATD      ,0.5        ,""         ,`BDBBT_cliplow    ,inf              ,"Gate dependent band-to-band tunneling shift exponent  of gate-edge component for drain-bulk junction")
