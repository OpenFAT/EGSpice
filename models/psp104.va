    `MPRco(FPHIGGAT2      ,1.0        ,""         ,`F2_cliplow       ,inf              ,"Zero-temperature bandgap voltage of gate-edge component factor, 2nd junction")
    `MPRcc(VTRGAT         ,-1.0       ,"V"        ,`VTRGAT_cliplow   ,`VTRGAT_cliphigh ,"Transition voltage of 2nd region gate-edge component, source-bulk junction")
    `MPRcc(ANUGAT         ,0.1        ,"V"        ,`ANUGAT_cliplow   ,`ANUGAT_cliphigh ,"Transition width coefficient of 2nd region gate-edge component, source-bulk 2nd junction")
    `MPRco(ADVBRGAT       ,0.0        ,""         ,`ADVBR_cliplow    ,inf              ,"Gate dependent breakdown voltage shift prefactor of gate-edge component for source-bulk junction")
    `MPRco(BDVBRGAT       ,0.5        ,""         ,`BDVBR_cliplow    ,inf              ,"Gate dependent breakdown voltage shift exponent of  gate-edge component for source-bulk junction")
    `MPRco(ADBBTGAT       ,0.0        ,""         ,`ADBBT_cliplow    ,inf              ,"Gate dependent band-to-band tunneling shift prefactor of gate-edge component for source-bulk junction")
    `MPRco(BDBBTGAT       ,0.5        ,""         ,`BDBBT_cliplow    ,inf              ,"Gate dependent band-to-band tunneling shift exponent  of gate-edge component for source-bulk junction")
`endif // JUNCAP_StandAlone

