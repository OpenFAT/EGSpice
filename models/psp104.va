    real slopebot_d, slopesti_d, slopegat_d;

    real cjorgat2nd_d, vbirgat2nd_d, pgat2nd_d, phiggat2nd_d, phigdgat2nd_d, phigrgat2nd_d, ftdgat2nd_d, ubigat2nd_d, vbigat2nd_d;
    real vbiinvgat2nd_d, one_minus_pgat2nd_d ,one_over_one_minus_pgat2nd_d, cjogat2nd_d, qprefgat2nd_d, qpref2gat2nd_d;
    real swgat2nd_d;

    real ADVBRGATD_i, BDVBRGATD_i, ADBBTGATD_i, BDBBTGATD_i;
    real vbrgat_var, vbrgat_var_d, dvbrgat, dvbrgat_d, dfbbtgat, dfbbtgat_d;

`endif // JUNCAP_StandAlone

