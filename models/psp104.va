`MPRnb(PLWCFDEDGE     ,0.0        ,"V^-1"                               ,"Binning parameter of the area dependence of CFDEDGE")
`MPRnb(PONFAEDGE      ,8.0e22     ,"V^-1/m^4"                           ,"Binning parameter of the geometry independent part of NFAEDGE")
`MPRnb(PLNFAEDGE      ,0.0        ,"V^-1/m^4"                           ,"Binning parameter of the length dependence of NFAEDGE")
`MPRnb(PWNFAEDGE      ,0.0        ,"V^-1/m^4"                           ,"Binning parameter of the width dependence of NFAEDGE")
`MPRnb(PLWNFAEDGE     ,0.0        ,"V^-1/m^4"                           ,"Binning parameter of the area dependence of NFAEDGE")
`MPRnb(PONFBEDGE      ,3.0e07     ,"V^-1/m^2"                           ,"Binning parameter of the geometry independent part of NFBEDGE")
`MPRnb(PLNFBEDGE      ,0.0        ,"V^-1/m^2"                           ,"Binning parameter of the length dependence of NFBEDGE")
