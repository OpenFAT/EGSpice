// The docs playground, a separate build root so ESPice's own builds and its
// package never fetch cktImg. pages.yml runs this build.
.{
    .name = .espice_playground,
    .version = "1.0.0",
    .fingerprint = 0x4bc183452cdd47d8,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        .espice = .{ .path = "../.." },
        .cktimg = .{
            .url = "git+https://github.com/OpenFAT/cktImg#f79ec5a4529496bff861dbf92306b837802d8f63",
            .hash = "NetlistParser-0.0.0-g79GuK4rCwCqws4vfH93K09_yc8ivZuCwF4I0j7H3udR",
        },
    },
    .paths = .{ "build.zig", "build.zig.zon", "cktimg.zig", "espice.zig" },
}
